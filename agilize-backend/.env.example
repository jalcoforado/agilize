# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=agilize_user
DB_PASSWORD=sua_senha_aqui
DB_NAME=agilize_db

# Server
PORT=3000
NODE_ENV=development

# JWT
JWT_SECRET=gere_um_secret_forte_aqui
JWT_EXPIRE=30m
JWT_REFRESH_EXPIRE=7d

# ──────────────────────────────────────────────────────────────
# Email — Google Workspace SMTP Relay
# ──────────────────────────────────────────────────────────────
# Mantenha SMTP_ENABLED=false em dev para não disparar emails reais.
# Em produção:
#   1. Admin habilita SMTP Relay no Google Admin Console
#      (Apps > Google Workspace > Gmail > Roteamento > SMTP Relay)
#      Configure autenticação por credenciais (não por IP).
#   2. Ative verificação em 2 etapas na conta remetente.
#   3. Gere App Password em myaccount.google.com/apppasswords (16 chars, sem espaços).
#   4. Preencha SMTP_USER e SMTP_PASSWORD com a conta e App Password.
# ──────────────────────────────────────────────────────────────
SMTP_ENABLED=false
SMTP_HOST=smtp-relay.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=agilize@tce.ce.gov.br
SMTP_PASSWORD=PASSWORD_ACCOUNT
SMTP_FROM_NAME=Agilize TCE-CE
SMTP_FROM_EMAIL=agilize@tce.ce.gov.br

# Timezone
TIMEZONE=America/Sao_Paulo

# API
API_VERSION=v1
API_BASE_URL=http://localhost:3000/api/v1
FRONTEND_URL=http://localhost:5173

# Logging
LOG_LEVEL=debug
