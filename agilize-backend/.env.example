# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=agilize_user
DB_PASSWORD=sua_senha_aqui
DB_NAME=agilize_db

# Server
PORT=3000
NODE_ENV=development

# JWT
JWT_SECRET=gere_um_secret_forte_aqui
JWT_EXPIRE=30m
JWT_REFRESH_EXPIRE=7d

# Email — configuração por ambiente
# DEV:  use Ethereal (smtp.ethereal.email) — emails capturados, nunca entregues
#       gere credenciais em: https://ethereal.email/create
# PROD: Gmail SMTP com App Password do Google Workspace
#   1. Ative 2FA na conta noreply@tce.ce.gov.br
#   2. Gere App Password em myaccount.google.com/apppasswords
#   3. Cole os 16 chars em SMTP_PASSWORD (sem espaços)
# Deixar SMTP_USER em branco desativa o envio de emails
SMTP_ENABLED=false
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=usuario@ethereal.email
SMTP_PASSWORD=senha_ethereal_aqui
SMTP_FROM_NAME=Agilize STI (Dev)
SMTP_FROM_EMAIL=usuario@ethereal.email

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# IA (Anthropic Claude)
ANTHROPIC_API_KEY=

# Timezone
TIMEZONE=America/Sao_Paulo

# API
API_VERSION=v1
API_BASE_URL=http://localhost:3000/api/v1
FRONTEND_URL=http://localhost:5173

# Logging
LOG_LEVEL=debug
