# === AGILIZE 2.0 — Variáveis de Produção ===
# Copie para .env.production e preencha os valores reais
# NUNCA commite .env.production no repositório

# --- Banco de dados ---
DB_HOST=postgres
DB_PORT=5432
DB_USER=agilize_user
DB_PASSWORD=TROQUE_POR_SENHA_FORTE
DB_NAME=agilize_db

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=TROQUE_POR_SENHA_FORTE

# --- JWT (mínimo 32 chars, gerado com: openssl rand -base64 48) ---
JWT_SECRET=TROQUE_POR_SECRET_FORTE
JWT_EXPIRE=30m
JWT_REFRESH_EXPIRE=7d

# --- Servidor ---
PORT=3000
NODE_ENV=production
FRONTEND_URL=https://agilize.seudominio.gov.br

# --- Email ---
SMTP_HOST=smtp.seudominio.gov.br
SMTP_PORT=587
SMTP_USER=noreply@seudominio.gov.br
SMTP_PASSWORD=TROQUE_POR_SENHA_EMAIL

# --- IA (opcional) ---
ANTHROPIC_API_KEY=
